# Copy this to .env for local testing only.
# In production (Render, Railway, etc.) set these as dashboard environment
# variables instead — never commit real credentials to git.

# The passphrase you'll type into the one-time browser "Authorize" screen
# the first time Claude connects. Generate one with: openssl rand -hex 32
# (Reused from the old MCP_TOKEN name so existing deployments don't need a
# new variable — AUTH_PASSWORD works too if you'd rather set that instead.)
MCP_TOKEN=

# This service's public HTTPS URL, e.g. https://your-app.onrender.com
# (no trailing slash). Required so OAuth can issue correct redirect/callback
# URLs. On Render this is usually set automatically via RENDER_EXTERNAL_URL,
# so you normally don't need to set BASE_URL there — only for local testing
# or other hosts.
BASE_URL=http://localhost:3000

# IMAP (reading mail) — get exact host/port from cPanel > Email Accounts > Connect Devices
IMAP_HOST=mail.staciacorp.com
IMAP_PORT=993
IMAP_USER=sarabeshsriram@staciacorp.com
IMAP_PASSWORD=

# SMTP (sending mail) — usually same host as IMAP
SMTP_HOST=mail.staciacorp.com
SMTP_PORT=465
# SMTP_USER / SMTP_PASSWORD default to IMAP_USER / IMAP_PASSWORD if omitted
