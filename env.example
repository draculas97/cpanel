# Copy this to .env for local testing only.
# In production (Render, Railway, etc.) set these as dashboard environment
# variables instead — never commit real credentials to git.

# --- Required for every deploy ---

# This service's public HTTPS URL, e.g. https://your-app.onrender.com
# (no trailing slash). Required so OAuth can issue correct redirect/callback
# URLs. On Render this is usually set automatically via RENDER_EXTERNAL_URL,
# so you normally don't need to set BASE_URL there — only for local testing
# or other hosts. This is also the single shared OAuth issuer for every
# tenant (see src/oauthProvider.js for why there's one, not one per tenant).
BASE_URL=http://localhost:3000

# Postgres connection string. Any managed Postgres works (Render's own,
# Supabase's free tier, etc) — this backend is provider-agnostic. Holds
# every tenant's config, contacts, messages, and OAuth state.
DATABASE_URL=

# Set false only for a local/self-hosted Postgres without a TLS cert Node
# trusts by default. Leave unset (true) for Render/Supabase.
# DATABASE_SSL=true

# Random secret used to encrypt tenant mailbox passwords/relay secrets at
# rest in Postgres. Generate with: openssl rand -hex 32
# Rotating this makes all previously-stored tenant credentials unreadable —
# treat it like a master key, back it up somewhere safe.
CONFIG_ENCRYPTION_KEY=

# Passphrase required to create new tenants via the /setup wizard. Leave
# unset only for a private/internal deploy where anyone who can reach the
# service is already trusted to onboard tenants.
SETUP_PASSWORD=

# --- Background job cadence (minutes; all optional, sensible defaults) ---
# REPLY_POLL_INTERVAL_MINUTES=5
# REMINDER_CHECK_INTERVAL_MINUTES=30
# DRIP_CHECK_INTERVAL_MINUTES=60

# --- Legacy single-tenant bootstrap (optional) ---
# If these are set AND no tenant with this slug exists yet, one is created
# automatically on first boot from these values — this is how the original
# single-mailbox "Stacia Mail" deployment migrates onto the multi-tenant
# backend without a manual setup-wizard step. Safe to leave all of this
# unset for a fresh multi-tenant-only deploy; onboard tenants via /setup
# instead.
# LEGACY_TENANT_SLUG=stacia
# AUTH_PASSWORD=
# MAIL_FROM_NAME=
# MAIL_FROM_ADDRESS=
# IMAP_HOST=mail.staciacorp.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=sarabeshsriram@staciacorp.com
# IMAP_PASSWORD=
# SMTP_HOST=mail.staciacorp.com
# SMTP_PORT=465
# RELAY_URL=
# RELAY_SECRET=
# SENT_FOLDER=INBOX.Sent
# DRAFTS_FOLDER=INBOX.Drafts
# SLACK_WEBHOOK_URL=
